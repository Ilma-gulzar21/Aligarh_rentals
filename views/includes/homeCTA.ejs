<!-- Rent CTA Section -->
  <link rel="stylesheet" href="/css/homeCss/CTA.css">
<section class="rent-cta">
    <div class="rent-cta-inner">

        <!-- Left: Tenants -->
        <div class="tenant-box">
            <h2>Looking for a place to stay in Aligarh?</h2>
            <p>Browse verified rooms, PGs, flats and houses, and talk to the owner directly.</p>

            <div class="type-list">
                <a href="/listings/more?type=room"><i class="fa-solid fa-bed"></i> Rooms</a>
