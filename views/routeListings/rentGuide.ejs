<% layout("fixLayout/boilerplate") %>

<link rel="stylesheet" href="/css/homeCss/rentGuide.css">


<main class="guide-page">


    <!-- =====================================================
         HERO
    ====================================================== -->

    <section class="guide-hero">

        <div class="guide-hero-content">

            <span class="guide-eyebrow">
                GUIDANCE CENTER
            </span>

            <h1>
                We're Here to
                <span>Guide You</span>
            </h1>

            <p>
                Aligarh Rentals is designed to make your search for
                a home, room, PG, or roommate in Aligarh easier,
                safer, and stress-free.
            </p>

            <a href="/listings" class="primary-button">
                Explore Listings
                <i class="fa-solid fa-arrow-right"></i>
            </a>


            <div class="trust-points">

                <div class="trust-item">

                    <div class="trust-icon blue">
                        <i class="fa-solid fa-house-circle-check"></i>
                    </div>

                    <div>
                        <strong>Trusted Platform</strong>
                        <span>Useful listings & information</span>
                    </div>

                </div>


                <div class="trust-item">

                    <div class="trust-icon green">
                        <i class="fa-solid fa-lock"></i>
                    </div>

                    <div>
                        <strong>Safe & Secure</strong>
                        <span>Your privacy is our priority</span>
                    </div>

                </div>


                <div class="trust-item">

                    <div class="trust-icon yellow">
                        <i class="fa-solid fa-headset"></i>
                    </div>

                    <div>
                        <strong>Here to Help</strong>
                        <span>Support at every step</span>
                    </div>

                </div>

            </div>

        </div>


        <div class="guide-hero-image">

            <img
                src="https://images.unsplash.com/photo-1564013799919-ab600027ffc6?auto=format&fit=crop&w=1200&q=85"
                alt="Beautiful rental home"
            >

        </div>

    </section>



    <!-- =====================================================
         ABOUT ALIGARH RENTALS
    ====================================================== -->

    <section class="about-section">

        <div class="about-content">

            <span class="guide-eyebrow">
                ABOUT ALIGARH RENTALS
            </span>

            <h2>
                Making rental search
                <span>simple for Aligarh.</span>
            </h2>

            <div class="green-line"></div>

            <p>
                Aligarh Rentals is a local rental platform created
                especially for people looking for homes, rooms,
                PGs and roommates in Aligarh.
            </p>

            <p>
                Whether you are a student, working professional,
                family, couple or someone moving to a new area,
                our platform helps you explore rental options
                according to your needs.
            </p>

            <p>
                Property owners can also list their available
                properties and provide important information such
                as rent, location, amenities and tenant preferences.
            </p>

            <a href="/listings" class="outline-button">
                Learn More About Listings
                <i class="fa-solid fa-arrow-right"></i>
            </a>

        </div>


        <div class="about-image">

            <img
                src="https://images.unsplash.com/photo-1556761175-b413da4baf72?auto=format&fit=crop&w=1000&q=85"
                alt="Aligarh Rentals platform"
            >

            <div class="about-image-label">

                <i class="fa-solid fa-location-dot"></i>

                <span>
                    Rental search made for
                    <strong>Aligarh</strong>
                </span>

            </div>

        </div>

    </section>



    <!-- =====================================================
         HOW WE GUIDE YOU
    ====================================================== -->

    <section class="how-section">

        <div class="section-title">

            <span class="guide-eyebrow">
                HOW IT WORKS
            </span>

            <h2>
                How We Guide You
            </h2>

            <p>
                From discovering a property to making your decision,
                Aligarh Rentals keeps your rental journey simple.
            </p>

        </div>


        <div class="guide-steps">


            <div class="guide-step">

                <div class="step-icon">
                    <i class="fa-solid fa-magnifying-glass"></i>
                </div>

                <span class="step-number">01</span>

                <h3>
                    Search with Ease
                </h3>

                <p>
                    Use search and filters to find properties
                    that match your location, budget and needs.
                </p>

            </div>


            <div class="step-connector"></div>


            <div class="guide-step">

                <div class="step-icon">
                    <i class="fa-solid fa-comments"></i>
                </div>

                <span class="step-number">02</span>

                <h3>
                    Connect & Communicate
                </h3>

                <p>
                    Check property details and connect with
                    owners or potential roommates.
                </p>

            </div>


            <div class="step-connector"></div>


            <div class="guide-step">

                <div class="step-icon">
                    <i class="fa-solid fa-heart"></i>
                </div>

                <span class="step-number">03</span>

                <h3>
                    Make Confident Choices
                </h3>

                <p>
                    Compare your options and choose a property
                    that works best for you.
                </p>

            </div>


            <div class="step-connector"></div>


            <div class="guide-step">

                <div class="step-icon">
                    <i class="fa-solid fa-house"></i>
                </div>

                <span class="step-number">04</span>

                <h3>
                    Move In Peacefully
                </h3>

                <p>
                    Find a place that suits your requirements
                    and begin your next chapter.
                </p>

            </div>

        </div>

    </section>



    <!-- =====================================================
         PROPERTY TYPES
    ====================================================== -->

    <section class="property-section">

        <div class="section-title left-title">

            <div>

                <span class="guide-eyebrow">
                    PROPERTY TYPES
                </span>

                <h2>
                    Explore homes by
                    <span>property type</span>
                </h2>

            </div>

            <p>
                Different rental options are available for
                different lifestyles, budgets and requirements.
            </p>

        </div>


        <div class="property-showcase">


            <a href="/listings/type/Apartment" class="property-item large">

                <img
                    src="https://images.unsplash.com/photo-1545324418-cc1a3fa10c00?auto=format&fit=crop&w=1000&q=85"
                    alt="Apartment"
                >

                <div class="property-overlay">
                    <span>01</span>
                    <h3>Apartment</h3>
                    <p>Comfortable homes for individuals and families</p>
                </div>

            </a>


            <a href="/listings/type/Flat" class="property-item">

                <img
                    src="https://images.unsplash.com/photo-1505693416388-ac5ce068fe85?auto=format&fit=crop&w=800&q=85"
                    alt="Flat"
                >

                <div class="property-overlay">
                    <span>02</span>
                    <h3>Flat</h3>
                    <p>Practical rental homes</p>
                </div>

            </a>


            <a href="/listings/type/PG" class="property-item">

                <img
                    src="https://images.unsplash.com/photo-1522708323590-d24dbb6b0267?auto=format&fit=crop&w=800&q=85"
                    alt="PG"
                >

                <div class="property-overlay">
                    <span>03</span>
                    <h3>PG</h3>
                    <p>Convenient shared accommodation</p>
                </div>

            </a>


            <a href="/listings/type/House" class="property-item">

                <img
                    src="https://images.unsplash.com/photo-1600585154340-be6161a56a0c?auto=format&fit=crop&w=800&q=85"
                    alt="House"
                >

                <div class="property-overlay">
                    <span>04</span>
                    <h3>House</h3>
                    <p>More space and privacy</p>
                </div>

            </a>


            <a href="/listings/type/Room" class="property-item">

                <img
                    src="https://images.unsplash.com/photo-1560185008-b033106af5c3?auto=format&fit=crop&w=800&q=85"
                    alt="Room"
                >

                <div class="property-overlay">
                    <span>05</span>
                    <h3>Room</h3>
                    <p>Simple and budget-friendly</p>
                </div>

            </a>

        </div>

    </section>



    <!-- =====================================================
         FIND A PROPERTY FOR YOU
    ====================================================== -->

    <section class="suitable-section">

        <div class="suitable-image">

            <img
                src="https://images.unsplash.com/photo-1529156069898-49953e39b3ac?auto=format&fit=crop&w=1000&q=85"
                alt="People looking for rental home"
            >

        </div>


        <div class="suitable-content">

            <span class="guide-eyebrow">
                FIND YOUR MATCH
            </span>

            <h2>
                Find a property
                <span>suitable for you</span>
            </h2>

            <p>
                Rental requirements can be different for everyone.
                Explore properties according to your situation
                and preferred tenant type.
            </p>


            <div class="audience-list">


                <div class="audience-item">

                    <div>
                        <i class="fa-solid fa-graduation-cap"></i>
                    </div>

                    <span>Students</span>

                </div>


                <div class="audience-item">

                    <div>
                        <i class="fa-solid fa-person"></i>
                    </div>

                    <span>Boys</span>

                </div>


                <div class="audience-item">

                    <div>
                        <i class="fa-solid fa-person-dress"></i>
                    </div>

                    <span>Girls</span>

                </div>


                <div class="audience-item">

                    <div>
                        <i class="fa-solid fa-people-roof"></i>
                    </div>

                    <span>Families</span>

                </div>


                <div class="audience-item">

                    <div>
                        <i class="fa-solid fa-heart"></i>
                    </div>

                    <span>Couples</span>

                </div>


                <div class="audience-item">

                    <div>
                        <i class="fa-solid fa-users"></i>
                    </div>

                    <span>Anyone</span>

                </div>


            </div>

        </div>

    </section>



    <!-- =====================================================
         HELP SECTION
    ====================================================== -->

    <section class="help-section">

        <div class="help-background">

            <img
                src="https://images.unsplash.com/photo-1600210492486-724fe5c67fb0?auto=format&fit=crop&w=1600&q=85"
                alt="Comfortable home interior"
            >

        </div>


        <div class="help-overlay"></div>


        <div class="help-content">

            <span class="guide-eyebrow">
                NEED HELP?
            </span>

            <h2>
                We've Got You.
            </h2>

            <div class="green-line"></div>

            <p>
                Check out our guidance and property information
                to make your rental journey smooth and hassle-free.
            </p>

            <a href="/listings" class="primary-button">
                View Rental Listings
                <i class="fa-solid fa-arrow-right"></i>
            </a>

        </div>


        <div class="help-links">


            <a href="/listings" class="help-link">

                <div class="help-link-icon green">
                    <i class="fa-solid fa-book-open"></i>
                </div>

                <div>
                    <strong>For Tenants</strong>
                    <span>Find homes, rooms or PGs easily.</span>
                </div>

                <i class="fa-solid fa-chevron-right"></i>

            </a>


            <a href="/listings/new" class="help-link">

                <div class="help-link-icon blue">
                    <i class="fa-solid fa-house"></i>
                </div>

                <div>
                    <strong>For Property Owners</strong>
                    <span>List your property for potential tenants.</span>
                </div>

                <i class="fa-solid fa-chevron-right"></i>

            </a>


            <div class="help-link">

                <div class="help-link-icon yellow">
                    <i class="fa-solid fa-shield-halved"></i>
                </div>

                <div>
                    <strong>Safety Tips</strong>
                    <span>Stay careful while choosing a property.</span>
                </div>

                <i class="fa-solid fa-chevron-right"></i>

            </div>


            <div class="help-link">

                <div class="help-link-icon purple">
                    <i class="fa-solid fa-headset"></i>
                </div>

                <div>
                    <strong>Help & Support</strong>
                    <span>Get answers to common questions.</span>
                </div>

                <i class="fa-solid fa-chevron-right"></i>

            </div>


        </div>

    </section>



    <!-- =====================================================
         RENT BUDGET
    ====================================================== -->

    <section class="budget-section">

        <div class="budget-content">

            <span class="guide-eyebrow">
                PLAN YOUR RENT
            </span>

            <h2>
                Understand your
                <span>rental budget</span>
            </h2>

            <p>
                Rental prices can vary depending on the location,
                property type, furnishing, size and available
                facilities. Always consider your monthly rent along
                with the security deposit and other charges before
                making a decision.
            </p>

        </div>


        <div class="budget-values">

            <div class="budget-value">

                <span>
                    Current lowest listing
                </span>

                <strong>
                    ₹<%= minimumRent ? minimumRent.toLocaleString("en-IN") : "0" %>
                </strong>

            </div>


            <div class="budget-divider"></div>


            <div class="budget-value">

                <span>
                    Current highest listing
                </span>

                <strong>
                    ₹<%= maximumRent ? maximumRent.toLocaleString("en-IN") : "0" %>
                </strong>

            </div>

        </div>

    </section>



    <!-- =====================================================
         OWNER CTA
    ====================================================== -->

    <section class="owner-cta">

        <div class="owner-cta-icon">
            <i class="fa-solid fa-house-circle-check"></i>
        </div>


        <div class="owner-cta-content">

            <span>
                FOR PROPERTY OWNERS
            </span>

            <h2>
                Have a property to rent?
            </h2>

            <p>
                List your property on Aligarh Rentals and
                connect with people searching for rental homes.
            </p>

        </div>


        <a href="/listings/new" class="primary-button">
            List Your Property
            <i class="fa-solid fa-arrow-right"></i>
        </a>

    </section>


</main>