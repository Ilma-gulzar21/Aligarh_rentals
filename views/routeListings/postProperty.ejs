                        <option value="Madrak">Madrak</option>

                        <!-- AGRA ROAD SIDE -->
                        <option value="Agra Road">Agra Road</option>
                        <option value="Agra Road Bypass">Agra Road Bypass</option>
                        <option value="Sarai Rahman">Sarai Rahman</option>
                        <option value="Madanpur">Madanpur</option>
                        <option value="Barauli">Barauli</option>
                        <option value="Barauli Road">Barauli Road</option>

                        <!-- KASIMPUR / HARDUAGANJ SIDE -->
                        <option value="Harduaganj">Harduaganj</option>
                        <option value="Harduaganj Road">Harduaganj Road</option>
