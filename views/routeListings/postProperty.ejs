                </div>

                <div class="apn-list-field-box">
                    <label>City</label>
                    <input type="text" name="city" class="apn-list-input" value="Aligarh" placeholder="Enter city name" required readonly>
                    <div class="apn-list-feedback"></div>
                </div>

                <div class="apn-list-field-box">
                    <label>Country</label>
                    <input type="text" name="country" class="apn-list-input" value="India" placeholder="Enter country name" required readonly>
                    <div class="apn-list-feedback"></div>
                </div>

                <div class="apn-list-field-box">
                    <label>Pincode</label>
                    <input type="text" name="pincode" autocomplete="postal-code" class="apn-list-input" placeholder="Example: 202001" maxlength="6" pattern="[0-9]{6}" required>
                    <div class="apn-list-feedback"></div>
                </div>

                <div class="apn-list-field-full">
                    <label>Complete Property Address</label>
                    <textarea name="fullAddress" autocomplete="off" class="apn-list-textarea" placeholder="Example: Near AMU Gate, Civil Lines, Aligarh, Uttar Pradesh" required></textarea>
                    <div class="apn-list-feedback"></div>
                </div>

                <div class="apn-list-field-full">
                    <label>Google Map Location Link</label>
                    <input type="url" name="googleMapLink" class="apn-list-input" placeholder="Paste Google Maps location link here">
                    <div class="apn-list-feedback"></div>
                </div>

            </div>
        </section>


        <!-- ========== 05 : NEARBY LANDMARKS ========== -->
        <section class="apn-list-step-section">

            <div class="apn-list-step-header">
                <div class="apn-list-step-number">05</div>
                <div>
                    <h2>Nearby Landmarks</h2>
                    <p>Add nearby universities, markets, hospitals and important locations.</p>
                </div>
            </div>

            <div id="apnListLandmarkContainer" class="apn-list-dynamic-area"></div>

            <button type="button" id="apnListAddLandmark" class="apn-list-outline-button">
                <i class="fa-solid fa-plus"></i>
                Add Another Landmark
            </button>

        </section>


        <!-- ========== 06 : BUILDING INFORMATION ========== -->
        <section class="apn-list-step-section">

            <div class="apn-list-step-header">
                <div class="apn-list-step-number">06</div>
                <div>
                    <h2>Building Information</h2>
                    <p>Provide floor details so tenants know the exact property location.</p>
                </div>
            </div>

            <div class="apn-list-fields-grid">

                <div class="apn-list-field-box">
                    <label>Total Floors in property</label>
                    <input type="number" name="totalFloors" class="apn-list-input" placeholder="Maximum 10 floors allowed" min="1" max="10" required>
                    <div class="apn-list-feedback"></div>
                </div>

                <div class="apn-list-field-box">
                    <label>How many Floors Available for Rent</label>
                    <input type="number" name="floor" class="apn-list-input" placeholder="Example: 4" min="1" max="10" required>
                    <div class="apn-list-feedback"></div>
                </div>

            </div>
        </section>


        <!-- ========== 07 : TENANT PREFERENCE ========== -->
        <section class="apn-list-step-section">

            <div class="apn-list-step-header">
                <div class="apn-list-step-number">07</div>
                <div>
                    <h2>Tenant Preference</h2>
                    <p>Choose which type of tenants you want and how quickly you will respond to them.</p>
                </div>
            </div>

            <div class="apn-list-fields-grid">

                <div class="apn-list-field-box">
                    <label>Preferred Tenant</label>
                    <select name="preferredTenant" class="apn-list-select" required>
                        <option value="">Select tenant preference</option>
                        <option value="Boys">Boys</option>
                        <option value="Girls">Girls</option>
                        <option value="Family">Family</option>
                        <option value="Couples">Couples</option>
                        <option value="Anyone">Anyone</option>
                        <option value="Student">Student</option>
                    </select>
                    <div class="apn-list-feedback"></div>
                </div>

                <div class="apn-list-field-box">
                    <label>Maximum Occupants</label>
                    <input type="number" name="maxOccupants" class="apn-list-input" placeholder="Example: 4 people" min="1" required>
                    <div class="apn-list-feedback"></div>
                </div>

                <div class="apn-list-field-box">
                    <label>Roommate Available</label>
                    <select name="roommateAvailable" id="apnListRoommateAvailable" class="apn-list-select" required>
                        <option value="">Select roommate requirement</option>
                        <option value="true">Yes, roommate required</option>
                        <option value="false">No roommate required</option>
                    </select>
                    <div class="apn-list-feedback"></div>
                </div>

                <div class="apn-list-field-box">
                    <label>Response Time</label>
                    <select name="responseTime" class="apn-list-select" required>
                        <option value="">Select response time</option>
                        <option value="Within 5 mins">Within 5 mins</option>
                        <option value="Within 30 mins">Within 30 mins</option>
                        <option value="Within 1 hour">Within 1 hour</option>
                        <option value="Within 24 hours">Within 24 hours</option>
                    </select>
                    <div class="apn-list-feedback"></div>
                </div>

            </div>
        </section>


        <!-- ========== 08 : EXISTING ROOMMATE DETAILS ========== -->
        <section class="apn-list-step-section" id="apnListRoommateSection" style="display:none;">

            <div class="apn-list-step-header">
                <div class="apn-list-step-number">08</div>
                <div>
                    <h2>Existing Roommate Details</h2>
                    <p>Add current roommate information if rooms are already occupied.</p>
                </div>
            </div>

            <div class="apn-list-field-box">
                <label>Current Occupants</label>

                <input
                    type="number"
                    name="currentOccupants"
                    class="apn-list-input"
                    placeholder="Example: 2 people already staying"
                    min="1"
                >

                <div class="apn-list-feedback"></div>
            </div>

            <div id="apnListRoommateContainer" class="apn-list-dynamic-area">

                <div class="apn-list-roommate-row">

                    <div>
                        <label>Name</label>
                        <input type="text" name="roommates[0][name]" class="apn-list-input" placeholder="Example: Hina">
                    </div>

                    <div>
                        <label>Gender</label>
                        <select name="roommates[0][gender]" class="apn-list-select">
                            <option value="">Select Gender</option>
                            <option value="Female">Female</option>
                            <option value="Male">Male</option>
                        </select>
                    </div>

                    <div>
                        <label>Age</label>
                        <input type="number" name="roommates[0][age]" class="apn-list-input" placeholder="Example: 22" min="1" max="100">
                    </div>

                </div>

            </div>

            <button type="button" id="apnListAddRoommate" class="apn-list-outline-button">
                <i class="fa-solid fa-user-plus"></i>
                Add Roommate
            </button>

        </section>


        <!-- ========== 09 : AVAILABILITY & LEASE ========== -->
        <section class="apn-list-step-section">

            <div class="apn-list-step-header">
                <div class="apn-list-step-number">09</div>
                <div>
                    <h2>Availability & Lease Details</h2>
                    <p>Tell tenants when they can move in and minimum stay duration.</p>
                </div>
            </div>

            <div class="apn-list-fields-grid">

                <div class="apn-list-field-box">
                    <label>Available From</label>
                    <input type="date" name="availableFrom" class="apn-list-input" required>
                    <div class="apn-list-feedback"></div>
                </div>

                <div class="apn-list-field-box">
                    <label>Minimum Lease Period</label>
                    <input type="number" name="minimumLeaseMonths" class="apn-list-input" placeholder="Example: 6 months" min="1" required>
                    <div class="apn-list-feedback"></div>
                </div>

                <div class="apn-list-field-box">
                    <label>Maximum Lease Period</label>
                    <input type="number" name="maximumLeaseMonths" class="apn-list-input" placeholder="Example: 24 months" min="1" max="11">
                    <div class="apn-list-feedback"></div>
                </div>

                <div class="apn-list-field-box">
                    <label>Property Status</label>
                    <select name="status" class="apn-list-select" required>
                        <option value="">Select status</option>
                        <option value="Available">Available</option>
                        <option value="Booked">Booked</option>
                        <option value="Occupied">Occupied</option>
                        <option value="Pending">Pending</option>
                    </select>
                    <div class="apn-list-feedback"></div>
                </div>

            </div>
        </section>


        <!-- ========== 10 : PROPERTY IMAGES ========== -->
        <section class="apn-list-step-section">

            <div class="apn-list-step-header">
                <div class="apn-list-step-number">10</div>
                <div>
                    <h2>Property Images</h2>
                    <p>Upload clear photos of rooms, kitchen, bathroom and surroundings.</p>
                </div>
            </div>

            <div class="apn-list-upload-box">

                <i class="fa-solid fa-images"></i>

                <h3>Upload Property Photos</h3>

                <p>Minimum 3 images recommended. Maximum 10 images allowed.</p>

                <input type="file" name="images" multiple accept="image/*" id="apnListImages" class="apn-list-file-input" required>

                <div class="apn-list-feedback" id="apnImageFeedback"></div>

            </div>

        </section>


        <!-- ========== FINAL PUBLISH ========== -->
        <section class="apn-list-submit-section">

            <div class="apn-list-submit-content">

                <div class="apn-list-submit-icon">
                    <i class="fa-solid fa-house-circle-check"></i>
                </div>

                <h2>Publish Your Property On Aligarh Rentals</h2>

                <p>
                    Check all details carefully before publishing.
                    Your property will become visible to tenants searching for rental homes in Aligarh.
                </p>

                <button type="submit" class="apn-list-submit-button">
                    <i class="fa-solid fa-paper-plane"></i>
                    Publish Listing
                </button>

            </div>

        </section>

    </form>

</section>