<% layout("fixLayout/boilerplate") %>
<link rel="stylesheet" href="/css/showPage/postProperty.css">

<section class="apn-list-create-page">

    <!-- ================= INTRO SECTION ================= -->
    <section class="apn-list-intro-section">

        <div class="apn-list-intro-content">
            <span class="apn-list-small-tag"> ALIGARH RENTALS </span>
            <h1> List Your Property And Connect With Verified Tenants </h1>
            <p>
                Rent your flat, room, PG or independent house with Aligarh Rentals.
                Add accurate details, pricing and photos to get better tenant enquiries
                from students, families and working professionals.
            </p>

            <div class="apn-list-benefit-row">

                <div class="apn-list-benefit-item">
                    <i class="fa-solid fa-circle-check"></i>
                    Verified Property Listing
                </div>

                <div class="apn-list-benefit-item">
                    <i class="fa-solid fa-users"></i>
                    Direct Tenant Reach
                </div>

                <div class="apn-list-benefit-item">
                    <i class="fa-solid fa-location-dot"></i>
                    Aligarh Local Network
                </div>

            </div>
        </div>

        <div class="apn-list-intro-card">
            <div class="apn-list-intro-icon">
                <i class="fa-solid fa-house-circle-check"></i>
            </div>

            <h3> Create Rental Listing</h3>
            <p> Complete property information helps tenants understand your property better.</p>

            <div class="apn-list-quality-box">
                <span><i class="fa-solid fa-check"></i> Property Information</span>
                <span><i class="fa-solid fa-check"></i> Location Details</span>
                <span><i class="fa-solid fa-check"></i> Rental Pricing</span>
                <span><i class="fa-solid fa-check"></i> Photos Upload</span>
            </div>
        </div>

    </section>


    <!-- ================= MAIN FORM ================= -->
  <form
    action="/listings"
    method="POST"
    enctype="multipart/form-data"
    class="apn-list-main-form"
    id="apnListPropertyForm"
    data-page="new"
>

        <!-- ========== 01 : PROPERTY DETAILS ========== -->
        <section class="apn-list-step-section">

            <div class="apn-list-step-header">
                <div class="apn-list-step-number">01</div>
                <div>
                    <h2>Property Details</h2>
                    <p>Tell tenants about your property type, space and facilities.</p>
                </div>
            </div>

            <div class="apn-list-fields-grid">

                <div class="apn-list-field-full">
                    <label>Property Title</label>
                    <input type="text" name="title" class="apn-list-input" placeholder="Example: Spacious 2 BHK Flat Near AMU Gate" required>
                    <div class="apn-list-feedback"></div>
                </div>

                <div class="apn-list-field-full">
                    <label>Property Description</label>
                    <textarea name="description" class="apn-list-textarea" placeholder="Describe rooms, ventilation, parking, nearby places, facilities and special features..." required></textarea>
                    <div class="apn-list-feedback"></div>
                </div>

                <div class="apn-list-field-box">
                    <label>Property Type</label>
                    <select name="propertyType" class="apn-list-select" required>
                        <option value="">Select property type</option>
                        <option>Flat</option>
                        <option>Apartment</option>
                        <option>Room</option>
                        <option>House</option>
                        <option>PG</option>
                    </select>
                    <div class="apn-list-feedback"></div>
                </div>

                <div class="apn-list-field-box">
                    <label>BHK Configuration</label>
                    <select name="bhk" class="apn-list-select" required>
                        <option value="">Select BHK</option>
                        <option>1 RK</option>
                        <option>1 BHK</option>
                        <option>2 BHK</option>
                        <option>3 BHK</option>
                        <option>4 BHK</option>
                    </select>
                    <div class="apn-list-feedback"></div>
                </div>

                <div class="apn-list-field-box">
                    <label>Furnishing Type</label>
                    <select name="furnishing" class="apn-list-select" required>
                        <option value="">Select furnishing</option>
                        <option>Furnished</option>
                        <option>Semi Furnished</option>
                        <option>Unfurnished</option>
                    </select>
                    <div class="apn-list-feedback"></div>
                </div>

                <div class="apn-list-field-box">
                    <label>Available For</label>
                    <select name="availableFor" class="apn-list-select" required>
                        <option value="">Who can rent this property?</option>
                        <option>Student</option>
                        <option>Family</option>
                        <option>Roommate</option>
                        <option>Visitor</option>
                    </select>
                    <div class="apn-list-feedback"></div>
                </div>

            </div>
        </section>


        <!-- ========== 02 : RENTAL PRICING ========== -->
        <section class="apn-list-step-section">

            <div class="apn-list-step-header">
                <div class="apn-list-step-number">02</div>
                <div>
                    <h2>Rental Pricing</h2>
                    <p>Set clear rental expectations so tenants can understand the complete cost.</p>
                </div>
            </div>

            <div class="apn-list-fields-grid">

                <div class="apn-list-field-box">
                    <label>Monthly Rent</label>
                    <input type="number" name="rentPrice" class="apn-list-input" placeholder="Example: ₹14000 per month" min="1" required>
                    <div class="apn-list-feedback"></div>
                </div>

                <div class="apn-list-field-box">
                    <label>Security Deposit</label>
                    <input type="number" name="securityDeposit" class="apn-list-input" placeholder="Example: ₹28000" min="0" required>
                    <div class="apn-list-feedback"></div>
                </div>

                <div class="apn-list-field-box">
                    <label>Maintenance Charge</label>
                    <input type="number" name="maintenanceCharge" class="apn-list-input" placeholder="Example: ₹800 per month" min="0">
                    <div class="apn-list-feedback"></div>
                </div>

                <div class="apn-list-field-box">
                    <label>Electricity Included</label>
                    <select name="electricityIncluded" class="apn-list-select" required>
                        <option value="">Select electricity option</option>
                        <option value="true">Yes, included</option>
                        <option value="false">No, separate payment</option>
                    </select>
                    <div class="apn-list-feedback"></div>
                </div>

            </div>
        </section>


        <!-- ========== 03 : OWNER CONTACT DETAILS ========== -->
        <section class="apn-list-step-section">

            <div class="apn-list-step-header">
                <div class="apn-list-step-number">03</div>
                <div>
                    <h2>Owner Contact Details</h2>
                    <p>Enter your mobile number so interested tenants can contact you.</p>
                </div>
            </div>

            <div class="apn-list-fields-grid">

                <div class="apn-list-field-box">
                    <label for="ownerPhone">Owner Mobile Number</label>

                    <input
                        type="tel"
                        id="ownerPhone"
                        name="ownerPhone"
                        class="apn-list-input"
                        placeholder="Enter 10-digit mobile number"
                        pattern="[6-9][0-9]{9}"
                        minlength="10"
                        maxlength="10"
                        inputmode="numeric"
                        autocomplete="tel"
                        required
                    >

                    <div class="apn-list-feedback"></div>
                </div>

            </div>

        </section>


