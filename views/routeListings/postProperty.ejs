                        <option value="Nehru Nagar">Nehru Nagar</option>
                        <option value="Naurangabad">Naurangabad</option>
                        <option value="Rambagh Colony">Rambagh Colony</option>
                        <option value="Saket Colony">Saket Colony</option>
                        <option value="Prem Nagar">Prem Nagar</option>
                        <option value="Surendra Nagar">Surendra Nagar</option>
                        <option value="Surendra Nagar Extension">Surendra Nagar Extension</option>
                        <option value="Shankar Vihar">Shankar Vihar</option>
                        <option value="Shiv Vihar">Shiv Vihar</option>
                        <option value="Raj Vihar">Raj Vihar</option>
                        <option value="Anupshahr Road">Anupshahr Road</option>
                        <option value="Anupshahr Road Bypass">Anupshahr Road Bypass</option>
