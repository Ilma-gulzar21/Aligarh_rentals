<% layout("fixLayout/boilerplate") %>

<link rel="stylesheet" href="/css/showPage/ownerBenifits.css">

<div class="ar-owner-page">

    <!-- =====================================================
         HERO
    ====================================================== -->

    <section class="ar-owner-hero">

        <div class="ar-owner-hero-content">

            <span class="ar-owner-tag">
                OWNER BENEFITS
            </span>

            <h1>
                More Visibility.<br>
                Better Tenants.<br>
                <span>Hassle-Free Renting.</span>
            </h1>

            <p>
                Aligarh Rentals helps property owners and landlords
                rent faster, smarter, and with complete peace of mind.
            </p>

            <div class="ar-owner-hero-actions">

                <a href="/listings/new" class="ar-owner-primary-btn">
                    List Your Property
                    <i class="fa-solid fa-arrow-right"></i>
                </a>

                <a href="/listings/guide" class="ar-owner-watch-btn">
                    <span class="ar-play-icon">
                        <i class="fa-solid fa-play"></i>
                    </span>

                    <span>See How It Works</span>
                </a>

            </div>


            <!-- TRUST POINTS -->

            <div class="ar-owner-trust">

                <div class="ar-owner-trust-item">

                    <div class="ar-trust-icon green">
                        <i class="fa-solid fa-shield-halved"></i>
                    </div>

                    <div>
                        <strong>Verified Tenants</strong>
                        <span>Quality tenants you can trust</span>
                    </div>

                </div>


                <div class="ar-owner-trust-item">

                    <div class="ar-trust-icon blue">
                        <i class="fa-regular fa-clock"></i>
                    </div>

                    <div>
                        <strong>Save Time</strong>
                        <span>We handle inquiries for you</span>
                    </div>

                </div>


                <div class="ar-owner-trust-item">

                    <div class="ar-trust-icon green">
                        <i class="fa-solid fa-lock"></i>
                    </div>

                    <div>
                        <strong>Secure & Reliable</strong>
                        <span>Safe transactions and support</span>
                    </div>

                </div>

            </div>

        </div>


        <!-- HERO IMAGE -->

        <div class="ar-owner-hero-visual">

            <div class="ar-owner-main-image">

                <img
                    src="https://images.unsplash.com/photo-1600607687920-4e2a09cf159d?auto=format&fit=crop&w=1200&q=85"
                    alt="Modern rental property interior"
                >

            </div>


            <!-- FLOATING ANALYTICS CARD -->

            <div class="ar-owner-result-card">

                <div class="ar-result-header">

                    <div>
                        <strong>Get Better Results</strong>
                        <span>Rent faster with the right exposure</span>
                    </div>

                </div>


                <div class="ar-result-stat">

                    <strong>+72%</strong>

                    <span>
                        Higher chance<br>
                        of renting fast
                    </span>

                </div>


                <div class="ar-mini-chart">

                    <svg
                        viewBox="0 0 300 105"
                        preserveAspectRatio="none"
                        aria-hidden="true"
                    >

                        <defs>

                            <linearGradient
                                id="chartGradient"
                                x1="0"
                                y1="0"
                                x2="0"
                                y2="1"
                            >

                                <stop
                                    offset="0%"
                                    stop-opacity=".28"
                                />

                                <stop
                                    offset="100%"
                                    stop-opacity="0"
                                />

                            </linearGradient>

                        </defs>


                        <path
                            class="chart-area"
                            d="M0 92 L35 65 L67 72 L95 50 L128 56 L158 35 L190 47 L220 25 L250 36 L300 5 L300 105 L0 105 Z"
                        />

                        <polyline
                            class="chart-line"
                            points="0,92 35,65 67,72 95,50 128,56 158,35 190,47 220,25 250,36 300,5"
                        />

                        <circle cx="35" cy="65" r="3"/>
                        <circle cx="95" cy="50" r="3"/>
                        <circle cx="158" cy="35" r="3"/>
                        <circle cx="220" cy="25" r="3"/>
                        <circle cx="300" cy="5" r="4"/>

                    </svg>

                </div>

                <span class="ar-chart-label">
                    This Month
                </span>

            </div>

        </div>

    </section>


    <!-- =====================================================
         WHY LIST
    ====================================================== -->

    <section class="ar-owner-why">

        <div class="ar-owner-section-heading">

            <h2>
                Why List Your Property on
                <span>Aligarh Rentals?</span>
            </h2>

            <div class="ar-heading-line"></div>

        </div>


        <div class="ar-owner-benefit-row">


            <article class="ar-owner-benefit-card">

                <div class="ar-benefit-icon green">
                    <i class="fa-solid fa-users"></i>
                </div>

                <h3>Wider Exposure</h3>

                <p>
                    Your property is seen by thousands
                    of potential tenants in Aligarh.
                </p>

            </article>


            <article class="ar-owner-benefit-card">

                <div class="ar-benefit-icon blue">
                    <i class="fa-solid fa-bullseye"></i>
                </div>

                <h3>Find the Right Tenants</h3>

                <p>
                    We connect you with verified
                    and genuine tenants.
                </p>

            </article>


            <article class="ar-owner-benefit-card">

                <div class="ar-benefit-icon yellow">
                    <i class="fa-regular fa-clock"></i>
                </div>

                <h3>Save Time & Effort</h3>

                <p>
                    Let us handle inquiries, so you
                    can focus on what matters.
                </p>

            </article>


            <article class="ar-owner-benefit-card">

                <div class="ar-benefit-icon purple">
                    <i class="fa-solid fa-shield-halved"></i>
                </div>

                <h3>Secure Transactions</h3>

                <p>
                    We prioritize safe communication
                    and transparent deals.
                </p>

            </article>


            <article class="ar-owner-benefit-card">

                <div class="ar-benefit-icon red">
                    <i class="fa-solid fa-headset"></i>
                </div>

                <h3>Dedicated Support</h3>

                <p>
                    Our team is always here to help
                    you at every step.
                </p>

            </article>


        </div>

    </section>


    <!-- =====================================================
         CTA STRIP
    ====================================================== -->

    <section class="ar-owner-final-cta">

        <div class="ar-final-icon">
            <i class="fa-solid fa-house"></i>
        </div>


        <div class="ar-final-content">

            <h2>
                Join Hundreds of Happy Property Owners
            </h2>

            <p>
                Start listing today and turn your empty property
                into a great opportunity.
            </p>

        </div>


        <a
            href="/listings/new"
            class="ar-final-btn"
        >
            List Your Property
            <i class="fa-solid fa-arrow-right"></i>
        </a>

    </section>


    <!-- =====================================================
         STATS
    ====================================================== -->

    <section class="ar-owner-stats">

        <div class="ar-owner-stat">

            <div class="ar-stat-circle">
                <i class="fa-solid fa-users"></i>
            </div>

            <div>
                <strong>2,500+</strong>
                <span>Active Tenants</span>
            </div>

        </div>


        <div class="ar-stat-separator"></div>


        <div class="ar-owner-stat">

            <div class="ar-stat-circle house">
                <i class="fa-solid fa-house"></i>
            </div>

            <div>
                <strong>1,200+</strong>
                <span>Properties Listed</span>
            </div>

        </div>


        <div class="ar-stat-separator"></div>


        <div class="ar-owner-stat">

            <div class="ar-stat-circle handshake">
                <i class="fa-solid fa-handshake"></i>
            </div>

            <div>
                <strong>98%</strong>
                <span>Satisfaction Rate</span>
            </div>

        </div>


        <div class="ar-stat-separator"></div>


        <div class="ar-owner-stat">

            <div class="ar-stat-circle support">
                <i class="fa-regular fa-clock"></i>
            </div>

            <div>
                <strong>24/7</strong>
                <span>Support Available</span>
            </div>

        </div>

    </section>


    <!-- =====================================================
         OWNER BENEFITS DETAIL
    ====================================================== -->

    <section class="ar-owner-detail">

        <div class="ar-owner-detail-heading">

            <h2>
                Benefits You Get as a
                <span>Property Owner</span>
            </h2>

        </div>


        <div class="ar-owner-detail-grid">


            <!-- IMAGE -->

            <div class="ar-owner-detail-image">

                <img
                    src="https://images.unsplash.com/photo-1556742049-0cfed4f6a45d?auto=format&fit=crop&w=1000&q=85"
                    alt="Property listing management"
                >

            </div>


            <!-- BENEFITS -->

            <div class="ar-owner-detail-benefits">


                <article class="ar-detail-item">

                    <div class="ar-detail-icon green">
                        <i class="fa-solid fa-bullhorn"></i>
                    </div>

                    <div>
                        <h3>Easy Property Listing</h3>

                        <p>
                            List your property in just a few
                            minutes with all the important details.
                        </p>
                    </div>

                </article>


                <article class="ar-detail-item">

                    <div class="ar-detail-icon blue">
                        <i class="fa-solid fa-eye"></i>
                    </div>

                    <div>
                        <h3>Better Visibility</h3>

                        <p>
                            Your listing gets maximum exposure
                            to the right audience.
                        </p>
                    </div>

                </article>


                <article class="ar-detail-item">

                    <div class="ar-detail-icon yellow">
                        <i class="fa-solid fa-user-check"></i>
                    </div>

                    <div>
                        <h3>Verified Inquiries</h3>

                        <p>
                            Receive inquiries only from genuine
                            and verified tenants.
                        </p>
                    </div>

                </article>


                <article class="ar-detail-item">

                    <div class="ar-detail-icon purple">
                        <i class="fa-regular fa-calendar-days"></i>
                    </div>

                    <div>
                        <h3>Faster Renting</h3>

                        <p>
                            Reduce vacancy time with quick
                            and quality tenant matches.
                        </p>
                    </div>

                </article>


                <article class="ar-detail-item">

                    <div class="ar-detail-icon red">
                        <i class="fa-solid fa-shield-halved"></i>
                    </div>

                    <div>
                        <h3>Secure & Transparent</h3>

                        <p>
                            Enjoy a safe renting experience
                            with full transparency.
                        </p>
                    </div>

                </article>


                <article class="ar-detail-item">

                    <div class="ar-detail-icon green">
                        <i class="fa-solid fa-headset"></i>
                    </div>

                    <div>
                        <h3>Personalized Support</h3>

                        <p>
                            Get dedicated assistance whenever
                            you need it.
                        </p>
                    </div>

                </article>


            </div>

        </div>

    </section>


    <!-- =====================================================
         FINAL CTA
    ====================================================== -->



</div>